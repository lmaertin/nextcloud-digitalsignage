#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "Running PHP syntax check..."
find . -name "*.php" ! -path "./vendor/*" ! -path "./.git/*" -exec php -l {} \;

if [ $? -ne 0 ]; then
  echo "Pre-commit hook: PHP syntax check failed." >&2
  exit 1
fi

echo "✓ PHP syntax check passed"
