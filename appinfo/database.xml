<?xml version="1.0" encoding="UTF-8"?>
<database>
    <name>*dbname*</name>
    <create>true</create>
    <overwrite>false</overwrite>
    <charset>utf8</charset>
    <table>
        <name>*dbprefix*digitalsignage_tokens</name>
        <declaration>
            <field>
                <name>id</name>
                <type>integer</type>
                <notnull>true</notnull>
                <autoincrement>true</autoincrement>
                <length>4</length>
            </field>
            <field>
                <name>token</name>
                <type>text</type>
                <notnull>true</notnull>
                <length>64</length>
            </field>
            <field>
                <name>user_id</name>
                <type>text</type>
                <notnull>true</notnull>
                <length>64</length>
            </field>
            <field>
                <name>name</name>
                <type>text</type>
                <notnull>true</notnull>
                <length>255</length>
            </field>
            <field>
                <name>created_at</name>
                <type>integer</type>
                <notnull>true</notnull>
                <length>4</length>
            </field>
            <index>
                <name>digitalsignage_token_idx</name>
                <unique>true</unique>
                <field>
                    <name>token</name>
                    <sorting>ascending</sorting>
                </field>
            </index>
            <index>
                <name>digitalsignage_user_idx</name>
                <field>
                    <name>user_id</name>
                    <sorting>ascending</sorting>
                </field>
            </index>
        </declaration>
    </table>
</database>
